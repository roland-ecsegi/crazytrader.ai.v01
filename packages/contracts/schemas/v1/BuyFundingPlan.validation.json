{
  "$defs": {
    "SimulationCostProfile": {
      "additionalProperties": false,
      "properties": {
        "fee_asset": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Fee Asset",
          "type": "string"
        },
        "maximum_slippage_bps": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Maximum Slippage Bps",
          "type": "string"
        },
        "profile_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Profile Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "const": "CONFIGURED_SIMULATION_ASSUMPTION",
          "default": "CONFIGURED_SIMULATION_ASSUMPTION",
          "title": "Source",
          "type": "string"
        },
        "taker_fee_bps": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Taker Fee Bps",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "taker_fee_bps",
        "maximum_slippage_bps",
        "fee_asset"
      ],
      "title": "SimulationCostProfile",
      "type": "object"
    },
    "VenueRuleReceipt": {
      "additionalProperties": false,
      "properties": {
        "rules": {
          "$ref": "#/$defs/VenueTradingRules"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "rules"
      ],
      "title": "VenueRuleReceipt",
      "type": "object"
    },
    "VenueTradingRules": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "enum": [
            "SANDBOX",
            "PUBLIC"
          ],
          "title": "Environment",
          "type": "string"
        },
        "metadata_version": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Metadata Version",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_json": {
          "maxLength": 2000000,
          "minLength": 2,
          "title": "Source Json",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "symbol": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "environment",
        "symbol",
        "metadata_version",
        "source_sha256",
        "source_json",
        "observed_at"
      ],
      "title": "VenueTradingRules",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "budget_currency": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Budget Currency",
      "type": "string"
    },
    "certification_effect": {
      "const": "NONE",
      "default": "NONE",
      "title": "Certification Effect",
      "type": "string"
    },
    "cost_profile_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Cost Profile Sha256",
      "type": "string"
    },
    "costs": {
      "$ref": "#/$defs/SimulationCostProfile"
    },
    "execution_mode": {
      "const": "SIMULATION",
      "default": "SIMULATION",
      "title": "Execution Mode",
      "type": "string"
    },
    "maximum_quote_debit": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Maximum Quote Debit",
      "type": "string"
    },
    "order_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Order Id",
      "type": "string"
    },
    "portfolio_currency": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Portfolio Currency",
      "type": "string"
    },
    "portfolio_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Portfolio Id",
      "type": "string"
    },
    "quantity": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Quantity",
      "type": "string"
    },
    "quote_fee_buffer": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Quote Fee Buffer",
      "type": "string"
    },
    "quote_notional_buffered": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Quote Notional Buffered",
      "type": "string"
    },
    "quote_reservation": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Quote Reservation",
      "type": "string"
    },
    "reference_price": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Reference Price",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "venue_rules": {
      "$ref": "#/$defs/VenueRuleReceipt"
    }
  },
  "required": [
    "tenant_id",
    "portfolio_id",
    "order_id",
    "portfolio_currency",
    "budget_currency",
    "quantity",
    "reference_price",
    "maximum_quote_debit",
    "costs",
    "cost_profile_sha256",
    "venue_rules",
    "quote_notional_buffered",
    "quote_fee_buffer",
    "quote_reservation"
  ],
  "title": "BuyFundingPlan",
  "type": "object"
}
