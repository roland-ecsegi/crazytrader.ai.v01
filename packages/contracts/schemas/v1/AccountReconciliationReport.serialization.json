{
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Actor Id",
      "type": "string"
    },
    "certification_effect": {
      "const": "NONE",
      "default": "NONE",
      "title": "Certification Effect",
      "type": "string"
    },
    "findings": {
      "items": {
        "enum": [
          "COMPARISON_FAILED",
          "SOURCE_UNAVAILABLE",
          "SOURCE_CHANGED",
          "CONCURRENT_STATE",
          "UNSUPPORTED_ACCOUNT_SCOPE",
          "PERMISSION_MISMATCH",
          "BALANCE_MISMATCH",
          "UNOWNED_ORDER",
          "ORDER_MISMATCH",
          "UNPOSTED_FILL",
          "FILL_MISMATCH",
          "QUOTE_MISMATCH",
          "RESERVATION_MISMATCH",
          "ATTRIBUTION_MISMATCH",
          "STATE_UNRESOLVED"
        ],
        "type": "string"
      },
      "title": "Findings",
      "type": "array"
    },
    "internal_head_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Internal Head Sha256",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "MATCHED",
        "MISMATCH",
        "UNAVAILABLE"
      ],
      "title": "Status",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "venue_account_ref": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Venue Account Ref",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "actor_id",
    "venue_account_ref",
    "source_sha256",
    "internal_head_sha256",
    "status",
    "findings",
    "occurred_at"
  ],
  "title": "AccountReconciliationReport",
  "type": "object"
}
