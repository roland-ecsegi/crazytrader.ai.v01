{
  "$defs": {
    "NativeSimulationJob": {
      "additionalProperties": false,
      "description": "Claimed protective request descriptor; models source, never grants approval.",
      "properties": {
        "client_order_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Client Order Id",
          "type": "string"
        },
        "costs": {
          "$ref": "#/$defs/SimulationCostProfile"
        },
        "engine_version": {
          "const": "1.221.0",
          "default": "1.221.0",
          "title": "Engine Version",
          "type": "string"
        },
        "event_at": {
          "format": "date-time",
          "title": "Event At",
          "type": "string"
        },
        "execution_mode": {
          "const": "SIMULATION",
          "default": "SIMULATION",
          "title": "Execution Mode",
          "type": "string"
        },
        "execution_request_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Execution Request Id",
          "type": "string"
        },
        "ledger_head_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Ledger Head Sha256",
          "type": "string"
        },
        "order_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Order Id",
          "type": "string"
        },
        "portfolio_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Portfolio Id",
          "type": "string"
        },
        "quantity": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Quantity",
          "type": "string"
        },
        "quote_source": {
          "const": "MODELED_FROM_APPROVED_REFERENCE",
          "default": "MODELED_FROM_APPROVED_REFERENCE",
          "title": "Quote Source",
          "type": "string"
        },
        "reference_price": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Reference Price",
          "type": "string"
        },
        "reference_risk_record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Reference Risk Record Sha256",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "side": {
          "const": "SELL",
          "default": "SELL",
          "title": "Side",
          "type": "string"
        },
        "starting_base": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Starting Base",
          "type": "string"
        },
        "starting_quote": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Starting Quote",
          "type": "string"
        },
        "symbol": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Symbol",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Tenant Id",
          "type": "string"
        },
        "venue_account_ref": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Venue Account Ref",
          "type": "string"
        },
        "venue_rules": {
          "$ref": "#/$defs/VenueRuleReceipt"
        }
      },
      "required": [
        "execution_request_id",
        "order_id",
        "request_sha256",
        "tenant_id",
        "portfolio_id",
        "venue_account_ref",
        "client_order_id",
        "symbol",
        "quantity",
        "reference_price",
        "reference_risk_record_sha256",
        "ledger_head_sha256",
        "venue_rules",
        "costs",
        "starting_base",
        "starting_quote",
        "event_at"
      ],
      "title": "NativeSimulationJob",
      "type": "object"
    },
    "SimulationCostProfile": {
      "additionalProperties": false,
      "properties": {
        "fee_asset": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Fee Asset",
          "type": "string"
        },
        "maximum_slippage_bps": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Maximum Slippage Bps",
          "type": "string"
        },
        "profile_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Profile Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "const": "CONFIGURED_SIMULATION_ASSUMPTION",
          "default": "CONFIGURED_SIMULATION_ASSUMPTION",
          "title": "Source",
          "type": "string"
        },
        "taker_fee_bps": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Taker Fee Bps",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "taker_fee_bps",
        "maximum_slippage_bps",
        "fee_asset"
      ],
      "title": "SimulationCostProfile",
      "type": "object"
    },
    "VenueRuleReceipt": {
      "additionalProperties": false,
      "properties": {
        "rules": {
          "$ref": "#/$defs/VenueTradingRules"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "rules"
      ],
      "title": "VenueRuleReceipt",
      "type": "object"
    },
    "VenueTradingRules": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "enum": [
            "SANDBOX",
            "PUBLIC"
          ],
          "title": "Environment",
          "type": "string"
        },
        "metadata_version": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Metadata Version",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_json": {
          "maxLength": 2000000,
          "minLength": 2,
          "title": "Source Json",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "symbol": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "environment",
        "symbol",
        "metadata_version",
        "source_sha256",
        "source_json",
        "observed_at"
      ],
      "title": "VenueTradingRules",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Raw native cash/event provenance; additive and distinct from SDK observations.",
  "properties": {
    "available": {
      "title": "Available",
      "type": "boolean"
    },
    "certification_effect": {
      "const": "NONE",
      "default": "NONE",
      "title": "Certification Effect",
      "type": "string"
    },
    "job": {
      "$ref": "#/$defs/NativeSimulationJob"
    },
    "job_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Job Sha256",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "raw_json": {
      "anyOf": [
        {
          "maxLength": 2000000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Raw Json"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "UNMODIFIED_NAUTILUS_SIMULATION",
      "default": "UNMODIFIED_NAUTILUS_SIMULATION",
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "job",
    "job_sha256",
    "observed_at",
    "available",
    "raw_json"
  ],
  "title": "NativeSimulationReceipt",
  "type": "object"
}
