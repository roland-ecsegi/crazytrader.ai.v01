        "action",
        "tenant_id",
        "venue_account_ref",
        "execution_request_id",
        "request_sha256",
        "client_order_id",
        "venue_order_id",
        "symbol",
        "side",
        "requested_quantity",
        "filled_quantity",
        "status",
        "observed_at"
      ],
      "title": "VenueOrderObservation",
      "type": "object"
