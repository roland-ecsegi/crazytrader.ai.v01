{
  "additionalProperties": false,
  "description": "Maintenance of an existing TradeIntent-derived order, no new exposure.",
  "properties": {
    "client_order_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Client Order Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "environment": {
      "enum": [
        "SANDBOX",
        "PUBLIC"
      ],
      "title": "Environment",
      "type": "string"
    },
    "execution_mode": {
      "enum": [
        "SIMULATION",
        "TESTNET",
        "PAPER",
        "SHADOW",
        "LIVE"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "order_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Order Id",
      "type": "string"
    },
    "origin_intent_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Origin Intent Id",
      "type": "string"
    },
    "origin_intent_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Origin Intent Sha256",
      "type": "string"
    },
    "portfolio_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Portfolio Id",
      "type": "string"
    },
    "request_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "symbol": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Symbol",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "tenant_id",
    "portfolio_id",
    "order_id",
    "client_order_id",
    "origin_intent_id",
    "origin_intent_sha256",
    "symbol",
    "environment",
    "execution_mode",
    "created_at",
    "expires_at"
  ],
  "title": "CancellationRequest",
  "type": "object"
}
