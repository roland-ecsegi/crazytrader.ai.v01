{
  "$defs": {
    "Lifecycle": {
      "enum": [
        "DRAFT",
        "BACKTESTED",
        "VALIDATED",
        "OUT_OF_SAMPLE",
        "WALK_FORWARD",
        "PAPER",
        "SHADOW",
        "CANARY_ELIGIBLE",
        "LIVE",
        "DEGRADED",
        "SUSPENDED",
        "RETIRED"
      ],
      "title": "Lifecycle",
      "type": "string"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "Metric",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_ref": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Artifact Ref",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_version": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Dataset Version",
      "type": "string"
    },
    "feature_set_version": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Feature Set Version",
      "type": "string"
    },
    "lifecycle_stage": {
      "$ref": "#/$defs/Lifecycle"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "title": "Metrics",
      "type": "array"
    },
    "model_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Model Id",
      "type": "string"
    },
    "model_version_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Model Version Id",
      "type": "string"
    },
    "training_config_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Training Config Hash",
      "type": "string"
    },
    "validation_evidence_refs": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:@/-]+$",
        "type": "string"
      },
      "title": "Validation Evidence Refs",
      "type": "array"
    }
  },
  "required": [
    "model_version_id",
    "model_id",
    "artifact_ref",
    "dataset_version",
    "feature_set_version",
    "training_config_hash",
    "metrics",
    "lifecycle_stage",
    "validation_evidence_refs",
    "created_at"
  ],
  "title": "ModelVersion",
  "type": "object"
}
