{
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Actor Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY"
      ],
      "title": "Decision",
      "type": "string"
    },
    "intent_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Intent Id",
      "type": "string"
    },
    "policy_bundle_version": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Policy Bundle Version",
      "type": "string"
    },
    "policy_decision_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Policy Decision Id",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:@/-]+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    }
  },
  "required": [
    "policy_decision_id",
    "intent_id",
    "actor_id",
    "decision",
    "reason_codes",
    "policy_bundle_version",
    "created_at"
  ],
  "title": "PolicyDecision",
  "type": "object"
}
