{
  "$defs": {
    "CancellationAuthorization": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Actor Id",
          "type": "string"
        },
        "client_order_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Client Order Id",
          "type": "string"
        },
        "context_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Context Sha256",
          "type": "string"
        },
        "decision": {
          "enum": [
            "ALLOW",
            "DENY"
          ],
          "title": "Decision",
          "type": "string"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "order_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Order Id",
          "type": "string"
        },
        "origin_intent_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Origin Intent Id",
          "type": "string"
        },
        "policy_bundle_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Policy Bundle Sha256",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:@/-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "request_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Request Id",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "tenant_id",
        "actor_id",
        "order_id",
        "client_order_id",
        "origin_intent_id",
        "request_sha256",
        "context_sha256",
        "policy_bundle_sha256",
        "decision",
        "reason_codes",
        "evaluated_at",
        "expires_at"
      ],
      "title": "CancellationAuthorization",
      "type": "object"
    },
    "CancellationContext": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Actor Id",
          "type": "string"
        },
        "certification_level": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "L5",
            "L6"
          ],
          "title": "Certification Level",
          "type": "string"
        },
        "client_order_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Client Order Id",
          "type": "string"
        },
        "environment": {
          "enum": [
            "SANDBOX",
            "PUBLIC"
          ],
          "title": "Environment",
          "type": "string"
        },
        "execution_mode": {
          "enum": [
            "SIMULATION",
            "TESTNET",
            "PAPER",
            "SHADOW",
            "LIVE"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "max_age_seconds": {
          "maximum": 30,
          "minimum": 1,
          "title": "Max Age Seconds",
          "type": "integer"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "order_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Order Id",
          "type": "string"
        },
        "order_state": {
          "enum": [
            "CREATED",
            "SUBMITTING",
            "SUBMITTED",
            "ACKNOWLEDGED",
            "PARTIALLY_FILLED",
            "CANCEL_PENDING",
            "UNKNOWN",
            "RECOVERY_REQUIRED",
            "FILLED",
            "CANCELLED",
            "REJECTED",
            "EXPIRED"
          ],
          "title": "Order State",
          "type": "string"
        },
        "origin_intent_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Origin Intent Id",
          "type": "string"
        },
        "origin_intent_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Origin Intent Sha256",
          "type": "string"
        },
        "owner_cancel_authorized": {
          "title": "Owner Cancel Authorized",
          "type": "boolean"
        },
        "owner_live_activated": {
          "title": "Owner Live Activated",
          "type": "boolean"
        },
        "ownership_proof_ref": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Ownership Proof Ref",
          "type": "string"
        },
        "portfolio_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Portfolio Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "symbol": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Symbol",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Tenant Id",
          "type": "string"
        },
        "venue_account_ref": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Venue Account Ref",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "actor_id",
        "portfolio_id",
        "order_id",
        "client_order_id",
        "origin_intent_id",
        "origin_intent_sha256",
        "symbol",
        "environment",
        "execution_mode",
        "ownership_proof_ref",
        "venue_account_ref",
        "order_state",
        "observed_at",
        "max_age_seconds",
        "owner_cancel_authorized",
        "certification_level",
        "owner_live_activated"
      ],
      "title": "CancellationContext",
      "type": "object"
    },
    "CancellationRequest": {
      "additionalProperties": false,
      "description": "Maintenance of an existing TradeIntent-derived order, no new exposure.",
      "properties": {
        "client_order_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Client Order Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "environment": {
          "enum": [
            "SANDBOX",
            "PUBLIC"
          ],
          "title": "Environment",
          "type": "string"
        },
        "execution_mode": {
          "enum": [
            "SIMULATION",
            "TESTNET",
            "PAPER",
            "SHADOW",
            "LIVE"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "order_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Order Id",
          "type": "string"
        },
        "origin_intent_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Origin Intent Id",
          "type": "string"
        },
        "origin_intent_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Origin Intent Sha256",
          "type": "string"
        },
        "portfolio_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Portfolio Id",
          "type": "string"
        },
        "request_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "symbol": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Symbol",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "tenant_id",
        "portfolio_id",
        "order_id",
        "client_order_id",
        "origin_intent_id",
        "origin_intent_sha256",
        "symbol",
        "environment",
        "execution_mode",
        "created_at",
        "expires_at"
      ],
      "title": "CancellationRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable cancellation authority built from the owned execution registry.",
  "properties": {
    "authorization": {
      "$ref": "#/$defs/CancellationAuthorization"
    },
    "context": {
      "$ref": "#/$defs/CancellationContext"
    },
    "execution_request_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Execution Request Id",
      "type": "string"
    },
    "execution_revision": {
      "minimum": 0,
      "title": "Execution Revision",
      "type": "integer"
    },
    "owner_config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Owner Config Sha256",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/CancellationRequest"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "execution_request_id",
    "owner_config_sha256",
    "execution_revision",
    "request",
    "context",
    "authorization"
  ],
  "title": "CancellationEvaluationRecord",
  "type": "object"
}
