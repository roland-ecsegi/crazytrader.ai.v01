{
  "additionalProperties": false,
  "properties": {
    "close_price": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Close Price",
      "type": "string"
    },
    "closed_at": {
      "format": "date-time",
      "title": "Closed At",
      "type": "string"
    },
    "environment": {
      "enum": [
        "SANDBOX",
        "PUBLIC"
      ],
      "title": "Environment",
      "type": "string"
    },
    "high_price": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "High Price",
      "type": "string"
    },
    "interval": {
      "enum": [
        "1m",
        "5m",
        "15m",
        "1h",
        "4h",
        "1d"
      ],
      "title": "Interval",
      "type": "string"
    },
    "low_price": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Low Price",
      "type": "string"
    },
    "metadata_version": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Metadata Version",
      "type": "string"
    },
    "open_price": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Open Price",
      "type": "string"
    },
    "opened_at": {
      "format": "date-time",
      "title": "Opened At",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "symbol": {
      "pattern": "^[A-Z0-9]{2,30}$",
      "title": "Symbol",
      "type": "string"
    },
    "trade_count": {
      "minimum": 0,
      "title": "Trade Count",
      "type": "integer"
    },
    "venue": {
      "const": "BINANCE",
      "default": "BINANCE",
      "title": "Venue",
      "type": "string"
    },
    "volume": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Volume",
      "type": "string"
    }
  },
  "required": [
    "environment",
    "symbol",
    "metadata_version",
    "interval",
    "opened_at",
    "closed_at",
    "open_price",
    "high_price",
    "low_price",
    "close_price",
    "volume",
    "trade_count"
  ],
  "title": "MarketCandle",
  "type": "object"
}
