{
  "$defs": {
    "ExecutionRequest": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Actor Id",
          "type": "string"
        },
        "client_order_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Client Order Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "environment": {
          "enum": [
            "SANDBOX",
            "PUBLIC"
          ],
          "title": "Environment",
          "type": "string"
        },
        "execution_mode": {
          "enum": [
            "SIMULATION",
            "TESTNET",
            "PAPER",
            "SHADOW",
            "LIVE"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "execution_request_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Execution Request Id",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "intent_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Intent Id",
          "type": "string"
        },
        "intent_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Intent Sha256",
          "type": "string"
        },
        "limit_price": {
          "anyOf": [
            {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Limit Price"
        },
        "metadata_version": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Metadata Version",
          "type": "string"
        },
        "order_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Order Id",
          "type": "string"
        },
        "order_type": {
          "enum": [
            "MARKET",
            "LIMIT"
          ],
          "title": "Order Type",
          "type": "string"
        },
        "owner_config_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Owner Config Id",
          "type": "string"
        },
        "policy_bundle_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Policy Bundle Sha256",
          "type": "string"
        },
        "portfolio_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Portfolio Id",
          "type": "string"
        },
        "quantity": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Quantity",
          "type": "string"
        },
        "risk_record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Risk Record Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "side": {
          "enum": [
            "BUY",
            "SELL"
          ],
          "title": "Side",
          "type": "string"
        },
        "symbol": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Symbol",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Tenant Id",
          "type": "string"
        },
        "venue_account_ref": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Venue Account Ref",
          "type": "string"
        }
      },
      "required": [
        "execution_request_id",
        "order_id",
        "tenant_id",
        "portfolio_id",
        "actor_id",
        "intent_id",
        "intent_sha256",
        "risk_record_sha256",
        "owner_config_id",
        "policy_bundle_sha256",
        "client_order_id",
        "venue_account_ref",
        "symbol",
        "side",
        "order_type",
        "quantity",
        "limit_price",
        "metadata_version",
        "execution_mode",
        "environment",
        "created_at",
        "expires_at"
      ],
      "title": "ExecutionRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bound_at": {
      "format": "date-time",
      "title": "Bound At",
      "type": "string"
    },
    "child_source_sha256": {
      "const": "113680db83443dacad4b124b407a298f75a1579ebdc0cf5d188833c2f937530b",
      "title": "Child Source Sha256",
      "type": "string"
    },
    "maximum_signature_window_ms": {
      "const": 5000,
      "default": 5000,
      "title": "Maximum Signature Window Ms",
      "type": "integer"
    },
    "protocol": {
      "const": "LOOPBACK_DEADLINE_GUARD_V1",
      "default": "LOOPBACK_DEADLINE_GUARD_V1",
      "title": "Protocol",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/ExecutionRequest"
    },
    "request_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "sdk_version": {
      "const": "3.0.0",
      "default": "3.0.0",
      "title": "Sdk Version",
      "type": "string"
    }
  },
  "required": [
    "request",
    "bound_at",
    "request_sha256",
    "child_source_sha256"
  ],
  "title": "FixtureDispatchBound",
  "type": "object"
}
