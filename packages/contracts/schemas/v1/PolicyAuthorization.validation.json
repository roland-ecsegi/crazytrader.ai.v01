{
  "$defs": {
    "PolicyDecision": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Actor Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decision": {
          "enum": [
            "ALLOW",
            "DENY"
          ],
          "title": "Decision",
          "type": "string"
        },
        "intent_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Intent Id",
          "type": "string"
        },
        "policy_bundle_version": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Policy Bundle Version",
          "type": "string"
        },
        "policy_decision_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Policy Decision Id",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:@/-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "policy_decision_id",
        "intent_id",
        "actor_id",
        "decision",
        "reason_codes",
        "policy_bundle_version",
        "created_at"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "RiskAuthorization": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Actor Id",
          "type": "string"
        },
        "context_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Context Sha256",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/RiskEvaluationDecision"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "execution_mode": {
          "enum": [
            "SIMULATION",
            "TESTNET",
            "PAPER",
            "SHADOW",
            "LIVE"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "intent_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Intent Sha256",
          "type": "string"
        },
        "limits_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Limits Sha256",
          "type": "string"
        },
        "notional": {
          "anyOf": [
            {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notional"
        },
        "quantity": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Quantity",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "tenant_id",
        "actor_id",
        "intent_sha256",
        "context_sha256",
        "limits_sha256",
        "quantity",
        "notional",
        "evaluated_at",
        "expires_at",
        "execution_mode"
      ],
      "title": "RiskAuthorization",
      "type": "object"
    },
    "RiskEffect": {
      "enum": [
        "RISK_INCREASING",
        "RISK_REDUCING",
        "RISK_NEUTRAL"
      ],
      "title": "RiskEffect",
      "type": "string"
    },
    "RiskEvaluationDecision": {
      "additionalProperties": false,
      "properties": {
        "calculated_exposure": {
          "anyOf": [
            {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calculated Exposure"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decision": {
          "enum": [
            "ALLOW",
            "DENY"
          ],
          "title": "Decision",
          "type": "string"
        },
        "drawdown_state": {
          "anyOf": [
            {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Drawdown State"
        },
        "intent_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Intent Id",
          "type": "string"
        },
        "market_health": {
          "enum": [
            "HEALTHY",
            "DEGRADED",
            "UNKNOWN"
          ],
          "title": "Market Health",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:@/-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "reconciliation_health": {
          "enum": [
            "HEALTHY",
            "DEGRADED",
            "UNKNOWN"
          ],
          "title": "Reconciliation Health",
          "type": "string"
        },
        "risk_decision_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Risk Decision Id",
          "type": "string"
        },
        "risk_effect": {
          "$ref": "#/$defs/RiskEffect"
        },
        "ruleset_version": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Ruleset Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "risk_decision_id",
        "intent_id",
        "decision",
        "risk_effect",
        "reason_codes",
        "calculated_exposure",
        "drawdown_state",
        "market_health",
        "reconciliation_health",
        "ruleset_version",
        "created_at"
      ],
      "title": "RiskEvaluationDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision": {
      "$ref": "#/$defs/PolicyDecision"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "policy_bundle_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Bundle Sha256",
      "type": "string"
    },
    "risk_authorization": {
      "$ref": "#/$defs/RiskAuthorization"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "decision",
    "risk_authorization",
    "policy_bundle_sha256",
    "evaluated_at",
    "expires_at"
  ],
  "title": "PolicyAuthorization",
  "type": "object"
}
