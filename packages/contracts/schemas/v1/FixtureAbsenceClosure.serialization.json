        "valuation_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:@/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valuation Ref"
        }
      },
      "required": [
        "posting_id",
        "portfolio_id",
        "account",
        "asset",
        "amount"
      ],
      "title": "LedgerPosting",
      "type": "object"
