{
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Actor Id",
      "type": "string"
    },
    "certification_level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "L6"
      ],
      "title": "Certification Level",
      "type": "string"
    },
    "client_order_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Client Order Id",
      "type": "string"
    },
    "environment": {
      "enum": [
        "SANDBOX",
        "PUBLIC"
      ],
      "title": "Environment",
      "type": "string"
    },
    "execution_mode": {
      "enum": [
        "SIMULATION",
        "TESTNET",
        "PAPER",
        "SHADOW",
        "LIVE"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "max_age_seconds": {
      "maximum": 30,
      "minimum": 1,
      "title": "Max Age Seconds",
      "type": "integer"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "order_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Order Id",
      "type": "string"
    },
    "order_state": {
      "enum": [
        "CREATED",
        "SUBMITTING",
        "SUBMITTED",
        "ACKNOWLEDGED",
        "PARTIALLY_FILLED",
        "CANCEL_PENDING",
        "UNKNOWN",
        "RECOVERY_REQUIRED",
        "FILLED",
        "CANCELLED",
        "REJECTED",
        "EXPIRED"
      ],
      "title": "Order State",
      "type": "string"
    },
    "origin_intent_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Origin Intent Id",
      "type": "string"
    },
    "origin_intent_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Origin Intent Sha256",
      "type": "string"
    },
    "owner_cancel_authorized": {
      "title": "Owner Cancel Authorized",
      "type": "boolean"
    },
    "owner_live_activated": {
      "title": "Owner Live Activated",
      "type": "boolean"
    },
    "ownership_proof_ref": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Ownership Proof Ref",
      "type": "string"
    },
    "portfolio_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Portfolio Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "symbol": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Symbol",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "venue_account_ref": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Venue Account Ref",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "actor_id",
    "portfolio_id",
    "order_id",
    "client_order_id",
    "origin_intent_id",
    "origin_intent_sha256",
    "symbol",
    "environment",
    "execution_mode",
    "ownership_proof_ref",
    "venue_account_ref",
    "order_state",
    "observed_at",
    "max_age_seconds",
    "owner_cancel_authorized",
    "certification_level",
    "owner_live_activated"
  ],
  "title": "CancellationContext",
  "type": "object"
}
