{
  "additionalProperties": false,
  "properties": {
    "base_asset": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Base Asset",
      "type": "string"
    },
    "environment": {
      "enum": [
        "SANDBOX",
        "PUBLIC"
      ],
      "title": "Environment",
      "type": "string"
    },
    "market_type": {
      "const": "SPOT",
      "default": "SPOT",
      "title": "Market Type",
      "type": "string"
    },
    "max_quantity": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Max Quantity",
      "type": "string"
    },
    "metadata_version": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Metadata Version",
      "type": "string"
    },
    "min_notional": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Min Notional",
      "type": "string"
    },
    "min_quantity": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Min Quantity",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "quantity_step": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Quantity Step",
      "type": "string"
    },
    "quote_asset": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Quote Asset",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "TRADING",
        "HALT",
        "BREAK"
      ],
      "title": "Status",
      "type": "string"
    },
    "symbol": {
      "pattern": "^[A-Z0-9]{2,30}$",
      "title": "Symbol",
      "type": "string"
    },
    "tick_size": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Tick Size",
      "type": "string"
    },
    "venue": {
      "const": "BINANCE",
      "default": "BINANCE",
      "title": "Venue",
      "type": "string"
    }
  },
  "required": [
    "environment",
    "symbol",
    "base_asset",
    "quote_asset",
    "status",
    "tick_size",
    "quantity_step",
    "min_quantity",
    "max_quantity",
    "min_notional",
    "metadata_version",
    "observed_at"
  ],
  "title": "InstrumentMetadata",
  "type": "object"
}
