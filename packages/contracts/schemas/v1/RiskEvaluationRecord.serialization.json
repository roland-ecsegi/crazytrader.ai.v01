          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "tenant_id",
        "actor_id",
        "intent_sha256",
        "context_sha256",
        "limits_sha256",
        "quantity",
        "notional",
        "evaluated_at",
        "expires_at",
        "execution_mode"
