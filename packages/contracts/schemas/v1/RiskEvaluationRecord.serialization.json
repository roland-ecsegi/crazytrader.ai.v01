        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "execution_mode": {
          "enum": [
            "SIMULATION",
            "TESTNET",
            "PAPER",
            "SHADOW",
            "LIVE"
          ],
