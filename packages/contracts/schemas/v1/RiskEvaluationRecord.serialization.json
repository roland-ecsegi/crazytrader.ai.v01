{
  "$defs": {
    "AssetBalance": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Asset",
          "type": "string"
        },
        "available": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Available",
          "type": "string"
        },
        "fees": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Fees",
          "type": "string"
        },
        "inventory": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Inventory",
          "type": "string"
        },
        "reserved": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Reserved",
          "type": "string"
        },
        "total_held": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Total Held",
          "type": "string"
        }
      },
      "required": [
        "asset",
        "available",
        "reserved",
        "inventory",
        "fees",
        "total_held"
      ],
      "title": "AssetBalance",
      "type": "object"
    },
    "CertificationState": {
      "additionalProperties": false,
      "properties": {
        "achieved_at": {
          "format": "date-time",
          "title": "Achieved At",
          "type": "string"
        },
        "blockers": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        },
        "current_level": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "L5",
            "L6"
          ],
          "title": "Current Level",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:@/-]+$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "last_reviewed_at": {
          "format": "date-time",
          "title": "Last Reviewed At",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "current_level",
        "achieved_at",
        "evidence_refs",
        "blockers",
        "last_reviewed_at"
      ],
      "title": "CertificationState",
      "type": "object"
    },
    "ConversionMetadata": {
      "additionalProperties": false,
      "properties": {
        "price": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Price",
          "type": "string"
        },
        "price_state_ref": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Price State Ref",
          "type": "string"
        },
        "quantity_step": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Quantity Step",
          "type": "string"
        },
        "rounding": {
          "const": "DOWN",
          "title": "Rounding",
          "type": "string"
        },
        "venue_metadata_version": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Venue Metadata Version",
          "type": "string"
        }
      },
      "required": [
        "price",
        "price_state_ref",
        "venue_metadata_version",
        "rounding",
        "quantity_step"
      ],
      "title": "ConversionMetadata",
      "type": "object"
    },
    "InstrumentMetadata": {
      "additionalProperties": false,
      "properties": {
        "base_asset": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Base Asset",
          "type": "string"
        },
        "environment": {
          "enum": [
            "SANDBOX",
            "PUBLIC"
          ],
          "title": "Environment",
          "type": "string"
        },
        "market_type": {
          "const": "SPOT",
          "default": "SPOT",
          "title": "Market Type",
          "type": "string"
        },
        "max_quantity": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Max Quantity",
          "type": "string"
        },
        "metadata_version": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Metadata Version",
          "type": "string"
        },
        "min_notional": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Min Notional",
          "type": "string"
        },
        "min_quantity": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Min Quantity",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "quantity_step": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Quantity Step",
          "type": "string"
        },
        "quote_asset": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Quote Asset",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "TRADING",
            "HALT",
            "BREAK"
          ],
          "title": "Status",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Z0-9]{2,30}$",
          "title": "Symbol",
          "type": "string"
        },
        "tick_size": {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Tick Size",
          "type": "string"
        },
        "venue": {
          "const": "BINANCE",
          "default": "BINANCE",
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "environment",
        "symbol",
        "base_asset",
        "quote_asset",
        "status",
        "tick_size",
        "quantity_step",
        "min_quantity",
        "max_quantity",
        "min_notional",
        "metadata_version",
        "observed_at"
      ],
      "title": "InstrumentMetadata",
      "type": "object"
    },
    "IntentType": {
      "enum": [
        "OPEN",
        "INCREASE",
        "REDUCE",
        "CLOSE",
        "REBALANCE"
      ],
      "title": "IntentType",
      "type": "string"
    },
    "Lifecycle": {
      "enum": [
        "DRAFT",
        "BACKTESTED",
        "VALIDATED",
        "OUT_OF_SAMPLE",
        "WALK_FORWARD",
        "PAPER",
        "SHADOW",
        "CANARY_ELIGIBLE",
        "LIVE",
        "DEGRADED",
        "SUSPENDED",
        "RETIRED"
      ],
      "title": "Lifecycle",
      "type": "string"
    },
    "MarketStatus": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "enum": [
            "SANDBOX",
            "PUBLIC"
          ],
          "title": "Environment",
          "type": "string"
        },
        "gap_target": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gap Target"
        },
        "health": {
          "enum": [
            "HEALTHY",
            "DEGRADED",
            "UNKNOWN"
          ],
          "title": "Health",
          "type": "string"
        },
        "last_exchange_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Exchange At"
        },
        "last_received_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Received At"
        },
        "last_trade_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Trade Id"
        },
        "metadata_version": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Metadata Version",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "FRESH",
            "STALE_OR_DISCONNECTED",
            "SEQUENCE_GAP",
            "CONTENT_CONFLICT",
            "NO_OBSERVATIONS"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Z0-9]{2,30}$",
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "const": "BINANCE",
          "default": "BINANCE",
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "environment",
        "symbol",
        "metadata_version",
        "health",
        "reason_code",
        "occurred_at",
        "last_trade_id",
        "gap_target",
        "last_exchange_at",
        "last_received_at"
      ],
      "title": "MarketStatus",
      "type": "object"
    },
    "PolicyAuthorization": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "policy_bundle_sha256": {
          "pattern": "^[a-f0-9]{64}$",
