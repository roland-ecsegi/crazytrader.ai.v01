{
  "additionalProperties": false,
  "description": "Mature SDK fixture observation; no claim of external venue certification.",
  "properties": {
    "action": {
      "enum": [
        "SUBMIT",
        "QUERY"
      ],
      "title": "Action",
      "type": "string"
    },
    "client_order_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Client Order Id",
      "type": "string"
    },
    "execution_request_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Execution Request Id",
      "type": "string"
    },
    "filled_quantity": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Filled Quantity",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "requested_quantity": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Requested Quantity",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "side": {
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "Side",
      "type": "string"
    },
    "source": {
      "const": "OFFICIAL_SDK_LOOPBACK_FIXTURE",
      "default": "OFFICIAL_SDK_LOOPBACK_FIXTURE",
      "title": "Source",
      "type": "string"
    },
    "status": {
      "enum": [
        "UNKNOWN",
        "NEW",
        "PARTIALLY_FILLED",
        "FILLED",
        "CANCELED",
        "REJECTED",
        "EXPIRED"
      ],
      "title": "Status",
      "type": "string"
    },
    "symbol": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Symbol",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "venue_account_ref": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Venue Account Ref",
      "type": "string"
    },
    "venue_order_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Venue Order Id"
    }
  },
  "required": [
    "action",
    "tenant_id",
    "venue_account_ref",
    "execution_request_id",
    "request_sha256",
    "client_order_id",
    "venue_order_id",
    "symbol",
    "side",
    "requested_quantity",
    "filled_quantity",
    "status",
    "observed_at"
  ],
  "title": "VenueOrderObservation",
  "type": "object"
}
