{
  "additionalProperties": false,
  "properties": {
    "environment": {
      "enum": [
        "SANDBOX",
        "PUBLIC"
      ],
      "title": "Environment",
      "type": "string"
    },
    "evidence_ref": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Evidence Ref",
      "type": "string"
    },
    "execution_mode": {
      "enum": [
        "SIMULATION",
        "TESTNET",
        "PAPER",
        "SHADOW",
        "LIVE"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "reconciliation_health": {
      "enum": [
        "HEALTHY",
        "DEGRADED",
        "UNKNOWN"
      ],
      "title": "Reconciliation Health",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_service": {
      "const": "reconciliation",
      "default": "reconciliation",
      "title": "Source Service",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "venue_account_ref": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Venue Account Ref",
      "type": "string"
    },
    "venue_health": {
      "enum": [
        "HEALTHY",
        "DEGRADED",
        "UNKNOWN"
      ],
      "title": "Venue Health",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "environment",
    "execution_mode",
    "venue_account_ref",
    "venue_health",
    "reconciliation_health",
    "observed_at",
    "evidence_ref"
  ],
  "title": "VenueSafetyFact",
  "type": "object"
}
